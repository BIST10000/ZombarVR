--- !u!102 &1073594580
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1073594577}
  m_Text: "\u041C\u0415\u041D\u042E\n\u041A\u0440\u043E\u0432\u0430\u0432\u044B\u0439 \u0444\u043B\u0438\u043F \u2014 \u041A\u0440\u043E\u0432\u044C \xD71  \xB7  \u0413\u043B\u0430\u0437 \xD71\r\n\u0413\u043D\u0438\u043B\u043E\u0439 \u0441\u0430\u0443\u044D\u0440 \u2014 \u041A\u0440\u043E\u0432\u044C \xD71  \xB7  \u041F\u043B\u043E\u0442\u044C \xD71\r\n\u0413\u043B\u0430\u0437\u043D\u043E\u0439 \u0445\u0430\u0439\u0431\u043E\u043B \u2014 \u0413\u043B\u0430\u0437 \xD71  \xB7  \u041F\u043B\u043E\u0442\u044C \xD71\r\n\u0414\u0432\u043E\u0439\u043D\u0430\u044F \u043A\u0440\u043E\u0432\u044C \u2014 \u041A\u0440\u043E\u0432\u044C \xD72  \xB7  \u0413\u043B\u0430\u0437 \xD71\r\n\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u2014 \u041A\u0440\u043E\u0432\u044C \xD71  \xB7  \u0413\u043B\u0430\u0437 \xD72\r\n\u041C\u044F\u0441\u043D\u043E\u0439 \u0443\u0434\u0430\u0440 \u2014 \u041A\u0440\u043E\u0432\u044C \xD72  \xB7  \u041F\u043B\u043E\u0442\u044C \xD71\r\n\u0422\u0440\u0435\u0442\u0438\u0439 \u0433\u043B\u0430\u0437 \u2014 \u0413\u043B\u0430\u0437 \xD72  \xB7  \u041F\u043B\u043E\u0442\u044C \xD71\r\n\u041C\u043E\u0440\u0433\u0442\u0438\u043D\u0438 \u2014 \u041A\u0440\u043E\u0432\u044C \xD71  \xB7  \u0413\u043B\u0430\u0437 \xD71  \xB7  \u041F\u043B\u043E\u0442\u044C \xD71\r\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0443\u0436\u0438\u043D \u2014 \u041A\u0440\u043E\u0432\u044C \xD71  \xB7  \u041F\u043B\u043E\u0442\u044C \xD72\r\n"
  m_OffsetZ: 0
