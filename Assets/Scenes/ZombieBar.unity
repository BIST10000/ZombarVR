  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1317505059}
  m_Text: "\u0420\u0415\u0426\u0415\u041F\u0422\u042B\n\u041A\u0440\u043E\u0432\u044C + \u0433\u043B\u0430\u0437 = \u0424\u043B\u0438\u043F\n\u041A\u0440\u043E\u0432\u044C + \u043F\u043B\u043E\u0442\u044C = \u0421\u0430\u0443\u044D\u0440\n\u0413\u043B\u0430\u0437 + \u043F\u043B\u043E\u0442\u044C = \u0425\u0430\u0439\u0431\u043E\u043B\n5 \u0432\u0441\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u043D\u0438\u0439 \u2192 \u043F\u0435\u0440\u0435\u043B\u0438\u0442\u044C"
